# Initialize EfficientDet model
def load_efficientdet_model():
    try:
        # Create EfficientDet model with explicit model name
        model_name = 'tf_efficientdet_d0'  # Explicit model name
        
        # Create the model with proper configuration
        config = get_efficientdet_config(model_name)
        config.num_classes = 91  # COCO dataset has 91 classes (including background)
        config.image_size = (512, 512)  # Smaller input size for better performance
        
        # Create the model with proper parameters
        model = create_model(
            model_name,  # Use the explicit model name
            bench_task='predict',
            num_classes=config.num_classes,
            pretrained=True,
            image_size=config.image_size
        )
        
        # Load pretrained weights
        try:
            checkpoint = torch.hub.load_state_dict_from_url(
                f'https://github.com/rwightman/efficientdet-pytorch/releases/download/v0.1/{model_name}.pth',
                map_location='cpu', progress=True
            )
            model.load_state_dict(checkpoint)
        except:
            print("Using randomly initialized weights (pretrained weights not available)")
        
        model.eval()
        return model, config
    except Exception as e:
        print(f"Error creating EfficientDet model: {e}")
        import traceback
        traceback.print_exc()
        return None, None

detection_model, model_config = load_efficientdet_model()
if detection_model is None:
    print("Failed to load EfficientDet model, using fallback detection method")
    # You might want to implement a fallback detection method here
    exit()

print("EfficientDet model loaded successfully!")

# Traffic signal state simulation
class TrafficSignal:
    def __init__(self):
        self.state = "red"
        self.last_change = time.time()
        self.cycle_time = 20
        self.detected_state = None
    
    def update(self, detected_state=None):
        if detected_state is not None:
            self.detected_state = detected_state
            return detected_state
        
        current_time = time.time()
        elapsed = current_time - self.last_change
        
        if elapsed > self.cycle_time:
            self.last_change = current_time
            if self.state == "red":
                self.state = "green"
            elif self.state == "green":
                self.state = "yellow"
            else:
                self.state = "red"
        
        return self.state

# Initialize traffic signal
